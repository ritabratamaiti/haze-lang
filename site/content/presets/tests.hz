-- A client that retries a lost request, and the tests Haze generates for it.
enum Phase = Sending | Waiting | Done | GaveUp
def loss : Num := 0.1

system Client {
  var phase : Phase := Sending
  var attempts : Num := 0
  var acked : Bool := false
  step {
    match phase {
      Sending => {
        attempts := attempts + 1
        let request_lost := flip(loss)
        let reply_lost := flip(loss)
        if request_lost or reply_lost { phase := Waiting }
        else { acked := true; phase := Done }
      }
      Waiting => { if attempts < 3 { phase := Sending } else { phase := GaveUp } }
      _ => skip
    }
  }
}

-- The 4 most likely runs, the rare failing runs, and a statistical test
-- with a known false-alarm rate for checking the real code.
#tests[4] Client |= after[6] acked
