-- Itai and Rodeh's synchronous leader election, 4 processes choosing from 2 values
-- (PRISM: dtmcs/leader_sync/leader4_2.pm), step for step: each round is a pick,
-- 3 reads and a decision
enum Phase = Pick | Read | Decide | Elected

system Leader {
  var phase : Phase := Pick
  var c : Num := 1
  var u1 : Bool := false
  var v1 : Num := 0
  var p1 : Num := 0
  var u2 : Bool := false
  var v2 : Num := 0
  var p2 : Num := 0
  var u3 : Bool := false
  var v3 : Num := 0
  var p3 : Num := 0
  var u4 : Bool := false
  var v4 : Num := 0
  var p4 : Num := 0
  step {
    match phase {
      Pick => {
        let r1 := uniform(0, 1)
        p1 := r1
        v1 := r1
        u1 := true
        let r2 := uniform(0, 1)
        p2 := r2
        v2 := r2
        u2 := true
        let r3 := uniform(0, 1)
        p3 := r3
        v3 := r3
        u3 := true
        let r4 := uniform(0, 1)
        p4 := r4
        v4 := r4
        u4 := true
        phase := Read
      }
      Read => {
        let ou1 := u1
        let ov1 := v1
        let ou2 := u2
        let ov2 := v2
        let ou3 := u3
        let ov3 := v3
        let ou4 := u4
        let ov4 := v4
        if c < 3 {
          u1 := ou1 and p1 != ov2
          v1 := ov2
          if not ou1 { p1 := 0 }
          u2 := ou2 and p2 != ov3
          v2 := ov3
          if not ou2 { p2 := 0 }
          u3 := ou3 and p3 != ov4
          v3 := ov4
          if not ou3 { p3 := 0 }
          u4 := ou4 and p4 != ov1
          v4 := ov1
          if not ou4 { p4 := 0 }
          c := c + 1
        } else {
          u1 := ou1 and p1 != ov2
          v1 := 0
          if ou1 { p1 := 0 }
          u2 := ou2 and p2 != ov3
          v2 := 0
          if ou2 { p2 := 0 }
          u3 := ou3 and p3 != ov4
          v3 := 0
          if ou3 { p3 := 0 }
          u4 := ou4 and p4 != ov1
          v4 := 0
          if ou4 { p4 := 0 }
          phase := Decide
        }
      }
      Decide => {
        if u1 or u2 or u3 or u4 { phase := Elected } else { phase := Pick; c := 1 }
        u1 := false
        v1 := 0
        p1 := 0
        u2 := false
        v2 := 0
        p2 := 0
        u3 := false
        v3 := 0
        p3 := 0
        u4 := false
        v4 := 0
        p4 := 0
      }
      _ => skip
    }
  }
}

#prob Leader |= eventually[5] phase == Elected
#expect Leader |= steps until phase == Elected
