-- Incident triage: given what monitoring observed, which component is at fault?
--
-- The prior for each root cause comes from past incidents, and each cause makes each
-- alert fire with some probability. `observe` then conditions every world on the
-- alerts we actually saw, which is an exact Bayesian update.

enum Cause = Database | Cache | Network | Deploy

input cause : Cause ~ {Database: 0.3, Cache: 0.2, Network: 0.35, Deploy: 0.15}

input timeouts : Bool ~ match cause {
  Database => flip(0.9), Cache => flip(0.3), Network => flip(0.8), Deploy => flip(0.4)
}
input error_5xx : Bool ~ match cause {
  Database => flip(0.7), Cache => flip(0.2), Network => flip(0.3), Deploy => flip(0.9)
}
input cache_misses : Bool ~ match cause {
  Database => flip(0.1), Cache => flip(0.95), Network => flip(0.2), Deploy => flip(0.1)
}

-- Before any evidence, the database is to blame 30% of the time.
#prob cause == Database

-- What monitoring saw: requests time out, the service returns 5xx errors, and the
-- cache-miss alert stays quiet.
observe timeouts
observe error_5xx
observe not cache_misses

#eval cause
#outcomes cause == Database

-- The runbook says to page the database on-call only if there is at least an even
-- chance that the database is the cause.
claim page_db_oncall : cause == Database with prob >= 0.5
