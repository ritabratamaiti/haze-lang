-- Incident triage: which component is at fault, given what monitoring observed?
-- Priors come from past incidents; alert behavior per root cause is probabilistic.
-- `observe` conditions every world on the evidence (exact Bayesian update).

enum Cause = Database | Cache | Network | Deploy

input cause : Cause ~ {Database: 0.3, Cache: 0.2, Network: 0.35, Deploy: 0.15}

input timeouts : Bool ~ match cause {
  Database => flip(0.9), Cache => flip(0.3), Network => flip(0.8), Deploy => flip(0.4)
}
input error_5xx : Bool ~ match cause {
  Database => flip(0.7), Cache => flip(0.2), Network => flip(0.3), Deploy => flip(0.9)
}
input cache_misses : Bool ~ match cause {
  Database => flip(0.1), Cache => flip(0.95), Network => flip(0.2), Deploy => flip(0.1)
}

#prob cause == Database

observe timeouts
observe error_5xx
observe not cache_misses

#eval cause
#outcomes cause == Database

-- Runbook policy: page the DB on-call only if the database is the likely cause.
claim page_db_oncall : cause == Database with prob >= 0.5
