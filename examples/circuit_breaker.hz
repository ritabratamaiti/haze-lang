-- A circuit breaker in front of a flaky upstream service.
--
-- The breaker has three states:
--   * Closed: requests go through to the upstream. Three failures in a row trip the
--     breaker to Open.
--   * Open: requests are rejected during a cool-down of two steps, after which the
--     breaker moves to HalfOpen.
--   * HalfOpen: one trial request goes through. If it succeeds the breaker closes,
--     and if it fails the breaker opens again.
--
-- All we know about the upstream's failure rate is a word, "flaky". That makes the
-- failure rate a fuzzy parameter, while each individual failure is still a random
-- event.

enum Breaker = Closed | Open | HalfOpen

param fail_rate : Num ~= {0.05: 0.3, 0.2: 1, 0.5: 0.6, 0.9: 0.2}

system CB {
  var state : Breaker := Closed
  var consecutive : Num := 0
  var cooldown : Num := 0
  var sent : Num := 0            -- requests that reached the upstream service
  var rejected : Num := 0
  step {
    match state {
      Closed => {
        sent := sent + 1
        if flip(fail_rate) {
          consecutive := consecutive + 1
          if consecutive >= 3 { state := Open; cooldown := 2 }
        } else {
          consecutive := 0
        }
      }
      Open => {
        rejected := rejected + 1
        cooldown := cooldown - 1
        if cooldown <= 0 { state := HalfOpen }
      }
      HalfOpen => {
        sent := sent + 1
        if flip(fail_rate) { state := Open; cooldown := 2 }
        else { state := Closed; consecutive := 0 }
      }
    }
    assert consecutive <= 3
  }
}

-- These safety properties are theorems: they hold on every path and for every
-- admissible failure rate.
theorem never_overloads : CB |= always[20] consecutive <= 3
theorem no_crash : CB |= always[20] not crashed
theorem open_has_cooldown : CB |= always[20] (state == Open implies cooldown >= 1)

-- How likely is the breaker to trip within the first six steps?
claim trips_quickly : CB |= eventually[6] state == Open
-- Is it back to serving traffic after 20 steps?
claim closed_at_20 : CB |= after[20] state == Closed
-- The expected number of requests rejected over 20 steps, which is the load shed.
#expect CB |= after[20] rejected

-- An informal service-level objective, "rejections are rare", written as a fuzzy set:
-- one rejection is fully rare, and eight or more are not rare at all.
def rare(n : Num) : Deg := ramp_down(n, 1, 8)
claim slo_rejections : CB |= after[20] rejected is rare
