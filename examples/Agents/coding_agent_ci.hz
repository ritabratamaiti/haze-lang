-- An AI coding agent in a CI pipeline
--
-- An agent is asked to fix an issue. It writes a patch, CI runs the repository's tests, and if
-- they fail the agent tries again, up to three times, before handing the issue to an engineer.
-- The trouble is that passing tests doesn't mean a patch is right. Wang, Pradel and Liu ("Are
-- 'Solved Issues' in SWE-bench Really Solved Correctly?", ICSE 2026) checked patches from
-- three agents that passed SWE-bench Verified's tests: 7.8% failed the developers' full test
-- suite, and 29.6% behaved differently from the developers' fix, of which 28.6% were certainly
-- incorrect. Their tool, PatchDiff, found those differences by generating tests automatically.
--
-- This model asks how often a wrong patch gets merged, and how much two extra gates help: tests
-- generated by a second agent to probe the patch's behavior, and review by an engineer.

-- How often one attempt produces a correct fix. Agents differ a lot by repository and task, so
-- this is only known roughly.
param solves : Num ~= {0.4: 0.6, 0.55: 1, 0.7: 0.5}

-- Of the patches that pass the repository's tests, the share that is actually wrong. From the
-- study: at least the 7.8% that fail the full developer test suite, about 16.3% once the
-- certainly incorrect divergent patches are added (7.8% + 28.6% of 29.6%), and at most the
-- 29.6% that behave differently at all.
param wrong_share : Num ~= {0.078: 0.6, 0.163: 1, 0.296: 0.4}

-- So an attempt is correct, wrong but passing the tests, or failing the tests.
def wrong_but_passes : Num := wrong_share * solves / (1 - wrong_share)

-- How well generated behavioral tests catch a wrong patch that passes the existing tests. The
-- study shows such tests exist; how many a given pipeline finds is an assumption.
param catches : Num ~= {0.5: 0.5, 0.7: 1, 0.85: 0.4}

enum Stage = Writing | Merged | Escalated

system Pipeline(generated_tests : Bool, review : Bool) {
  var stage : Stage := Writing
  var attempts : Num := 0
  var wrong : Bool := false          -- the merged patch is wrong
  var ci_runs : Num := 0
  step {
    if stage == Writing {
      attempts := attempts + 1
      ci_runs := ci_runs + 1
      let outcome := {1: solves, 2: wrong_but_passes, 3: 1 - solves - wrong_but_passes}
      -- 1: correct, 2: wrong but passes the existing tests, 3: fails the tests
      let passes_tests := outcome != 3
      -- generated tests catch most wrong patches, and wrongly fail 5% of correct ones
      let passes_generated := if not generated_tests then true
        else if outcome == 2 then not flip(catches) else not flip(0.05)
      -- an engineer catches 60% of the wrong patches that reach review, and sends back 2% of
      -- correct ones
      let approved := if not review then true
        else if outcome == 2 then flip(0.4) else flip(0.98)
      if passes_tests and passes_generated and approved {
        stage := Merged
        wrong := outcome == 2
      } else if attempts >= 3 {
        stage := Escalated
      }
    }
  }
}

-- Whatever the rates, the pipeline never makes more than three attempts and always finishes.
theorem bounded_attempts : Pipeline(true, true) |= always[5] attempts <= 3
theorem finishes : Pipeline(true, true) |= eventually[3] stage != Writing

-- Tests only: how often an issue ends with a merge, and how often that merge is wrong.
claim merged_tests_only : Pipeline(false, false) |= after[3] stage == Merged
claim wrong_merge_tests_only : Pipeline(false, false) |= after[3] (stage == Merged and wrong)
#prob Pipeline(false, false) |= after[3] wrong given stage == Merged

-- Adding generated tests, then review as well.
claim wrong_merge_generated : Pipeline(true, false) |= after[3] (stage == Merged and wrong)
#prob Pipeline(true, false) |= after[3] wrong given stage == Merged
claim wrong_merge_both : Pipeline(true, true) |= after[3] (stage == Merged and wrong)
#prob Pipeline(true, true) |= after[3] wrong given stage == Merged

-- The price of the extra gates: fewer merges and more CI runs per issue.
claim merged_both : Pipeline(true, true) |= after[3] stage == Merged
#expect Pipeline(false, false) |= after[3] ci_runs
#expect Pipeline(true, true) |= after[3] ci_runs

-- A team that wants at most 1 wrong merge in 50 merged patches can hold the pipeline to it.
claim precision_target : Pipeline(true, true) |= after[3] wrong given stage == Merged
  with prob <= 0.02
