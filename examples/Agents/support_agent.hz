-- Reliability of a customer-support agent
--
-- An AI agent that handles refund requests has two kinds of reliability problem. It can be
-- inconsistent, solving a task on one run and failing it on the next, and it can make a wrong
-- decision that a safeguard has to catch. This file looks at both.

-- Consistency -------------------------------------------------------------------------------------
-- τ-bench (Yao, Shinn, Razavi and Narasimhan, Sierra, 2024) runs customer-service agents
-- against simulated users and a store's policy. On its retail tasks a GPT-4o agent succeeded
-- 61.2% of the time on a single run (pass^1), but fewer than 25% of tasks were solved on all
-- eight of eight runs (pass^8). An average success rate hides that gap.
--
-- A simple way to explain both numbers is that tasks differ: on some the agent is reliable,
-- on others it is close to a coin flip. With 30% of tasks solved 97% of the time and the rest
-- 45.86% of the time, the overall success rate is 61.2%, and Haze can work out what that
-- means for repeated runs. (The split is a fit to the two published numbers, not a
-- measurement.)

enum Kind = Reliable | Unreliable
input task : Kind ~ {Reliable: 0.3, Unreliable: 0.7}
def success_rate : Num := match task { Reliable => 0.97, Unreliable => 0.4586 }

-- The same task is run k times; all_ok records whether every run so far succeeded.
system Runs {
  var runs : Num := 0
  var all_ok : Bool := true
  step {
    runs := runs + 1
    if not flip(success_rate) { all_ok := false }
  }
}

claim pass_1 : Runs |= after[1] all_ok                 -- about 61.2%, as published
claim pass_2 : Runs |= after[2] all_ok
claim pass_8 : Runs |= after[8] all_ok with prob <= 0.25   -- the published "under 25%"

-- A refund workflow with safeguards ------------------------------------------------------------------
-- Now a single conversation, step by step. The agent reads the request, looks the order up
-- with a tool that sometimes times out, and decides what to refund. A policy checker reviews
-- every decision, refunds over $500 also need a person to approve them, and the payment call
-- uses an idempotency key. The step success rates below are assumptions for illustration, as
-- you would estimate them from your own evaluations; since they are only known roughly, each
-- is a fuzzy parameter.

enum Phase = Reading | LookingUp | Deciding | Checking | Approving | Paying | Refunded
           | Declined | Escalated

param understands : Num ~= {0.95: 0.6, 0.97: 1, 0.99: 0.5}     -- reads the request correctly
param decides_well : Num ~= {0.9: 0.6, 0.94: 1, 0.97: 0.5}     -- picks the right refund
param checker_catches : Num ~= {0.8: 0.6, 0.9: 1}               -- policy checker spots a wrong decision

input amount : Num ~ {40: 0.6, 180: 0.3, 750: 0.1}             -- size of the requested refund
input eligible : Bool ~ flip(0.85)                              -- does the policy allow a refund?

system Agent {
  var phase : Phase := Reading
  var understood : Bool := false
  var lookup_tries : Num := 0
  var decision : Bool := false        -- the agent wants to refund
  var approved : Bool := false        -- a person approved a large refund
  var checked : Bool := false         -- the policy checker passed the decision
  var payments : Num := 0             -- refunds actually sent to the payment API
  step {
    match phase {
      Reading => {
        understood := flip(understands)
        phase := LookingUp
      }
      LookingUp => {
        lookup_tries := lookup_tries + 1
        if flip(0.95) { phase := Deciding }                    -- the order service answered
        else if lookup_tries >= 3 { phase := Escalated }       -- give up and hand over
      }
      Deciding => {
        -- a correct decision follows the policy; a wrong one gets it backwards
        let right := understood and flip(decides_well)
        decision := if right then eligible else not eligible
        phase := if decision then Checking else Declined
      }
      Checking => {
        -- the checker passes correct refunds and catches most wrong ones
        if eligible or not flip(checker_catches) {
          checked := true
          phase := if amount > 500 then Approving else Paying
        } else {
          phase := Escalated
        }
      }
      Approving => {
        -- a reviewer approves eligible refunds and rejects 95% of ineligible ones
        if eligible or flip(0.05) { approved := true; phase := Paying }
        else { phase := Escalated }
      }
      Paying => {
        if payments == 0 { payments := 1 }                     -- idempotent payment call
        phase := Refunded
      }
      _ => skip
    }
  }
}

-- Safeguards that hold on every path, whatever the true rates turn out to be.
theorem one_payment : Agent |= always[10] payments <= 1
theorem checked_before_paying : Agent |= always[10] (payments > 0 implies checked)
theorem large_refunds_approved : Agent |= always[10] ((payments > 0 and amount > 500) implies approved)
theorem always_finishes : Agent |= eventually[8]
  (phase == Refunded or phase == Declined or phase == Escalated)

-- How often does a customer get the right outcome, and how often is money paid out wrongly?
claim correct : Agent |= after[8] ((phase == Refunded and eligible) or (phase == Declined and not eligible))
claim wrong_refund : Agent |= after[8] (phase == Refunded and not eligible)
claim wrong_refund_large : Agent |= after[8] (phase == Refunded and not eligible and amount > 500)
claim wrongly_declined : Agent |= after[8] (phase == Declined and eligible)
#eval Agent |= after[8] phase
#expect Agent |= after[8] (if phase == Refunded and not eligible then amount else 0)
