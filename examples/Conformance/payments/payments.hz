-- The specification of the payment client in payments_client.py.
--
-- The client sends a charge request to the payment server and, if no answer arrives
-- before the timeout, tries again, making at most three attempts. The network can
-- lose either the request or the response, and we only know its loss rate vaguely.
-- The server deduplicates requests by idempotency key, so a retried request never
-- charges the card a second time.
--
-- The theorems and bounds below must hold for the specification to be accepted.
-- test_conformance.py then checks that the Python implementation produces exactly
-- the outcome distributions that Haze computes here.

enum Phase = Sending | Waiting | Done | GaveUp

param loss : Num ~= {0.01: 0.6, 0.02: 1, 0.05: 0.5, 0.1: 0.2}

def max_attempts : Num := 3
def timeout_ms : Num := 1000
def rtt_ms : Num := 80

system Client {
  var phase : Phase := Sending
  var attempts : Num := 0
  var charges : Num := 0
  var acked : Bool := false
  var latency : Num := 0
  step {
    match phase {
      Sending => {
        attempts := attempts + 1
        -- naming each random decision with `let` makes generated tests readable
        let request_lost := flip(loss)
        if request_lost {
          phase := Waiting
        } else {
          if charges == 0 { charges := 1 }      -- the server charges once per key
          let response_lost := flip(loss)
          if response_lost {
            phase := Waiting
          } else {
            acked := true
            latency := latency + rtt_ms
            phase := Done
          }
        }
      }
      Waiting => {
        latency := latency + timeout_ms
        if attempts < max_attempts { phase := Sending } else { phase := GaveUp }
      }
      _ => skip
    }
  }
}

-- Safety, and a deadline: these must hold on every path and for every admissible
-- loss rate.
theorem single_charge : Client |= always[6] charges <= 1
theorem ack_means_charged : Client |= always[6] (acked implies charges == 1)
theorem bounded_attempts : Client |= always[6] attempts <= max_attempts
theorem terminates : Client |= eventually[6] (phase == Done or phase == GaveUp)

-- The service-level requirement: at least 99% of payments are acknowledged.
claim delivered : Client |= after[6] acked with prob >= 0.99

-- The outcome distributions that the implementation must match exactly.
#eval Client |= after[6] phase
#eval Client |= after[6] charges
#eval Client |= after[6] attempts
#eval Client |= after[6] latency
#expect Client |= after[6] latency

-- Probability-weighted tests. The first lists the most likely runs, which test_weighted.py
-- replays against the implementation, so the suite covers the behaviour that happens most often.
-- The second adds a statistical test for a property that fails by design some of the time:
-- a payment can give up after three lost messages.
#tests[6] Client |= always[6] charges <= 1
#tests[3] Client |= after[6] acked
