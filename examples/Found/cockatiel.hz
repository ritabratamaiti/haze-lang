-- cockatiel bulkhead: what happens to a queued call between the moment a running call frees its
-- execution slot and the moment the queued call is started.
--
-- cockatiel 4.0.0 (npm latest, published 2026-05-26, gitHead f475a69) and master at 7d53faf
-- (2026-10-29). src/BulkheadPolicy.ts has the same line numbers at both commits; they differ only
-- in the import on line 4 and in how line 77 calls fn.
--
-- Configuration from the reproduction: bulkhead(2, 2). Two calls are running (A1, A2) and two are
-- queued (X, Y); up to three more calls arrive (N1, N2, N3).
--
-- Model element -> source (src/BulkheadPolicy.ts at 7d53faf)
--   running    calls between `this.active++` (line 75) and `this.active--` (line 79);
--              executionSlots is capacity - active (lines 42-44)
--   queued     this.queue.length (lines 84-87; queueSlots, lines 49-51)
--   pending    items that dequeue() has removed with queue.shift() (line 95) and whose
--              Promise.resolve().then(...) callback (lines 100-108) has not run yet
--   Finish     the finally block of a running call: active--, then dequeue() (lines 78-81)
--   Arrive     a new execute() call: run if active < capacity (lines 74-75), else queue if
--              queue.length < queueCapacity (lines 84-87), else onReject and
--              BulkheadRejectedError (lines 90-91)
--   Handoff    the dequeue callback calls this.execute(item.fn, item.signal) again (line 107),
--              which repeats the checks of lines 74-91 for the call that had been queued
--
-- Abstractions, and why the conclusions survive them:
--   * Calls are counted, not named. The bulkhead decides only on `active` and `queue.length`.
--   * Each event is one JavaScript job with no await inside it, so it is atomic, and the model
--     lets the events happen in any order. JavaScript allows fewer orders (a dequeue callback runs
--     before any timer or I/O callback), so each failing run has to be matched with real code:
--     the shortest one is the report's second script, and the first script's run ends in the
--     state of the #prob line below. Every real order is a model order, so the theorems that hold
--     for the fix hold for every real order.
--   * Abort signals are left out. In the released code they only add paths through dequeue(). In
--     the fix, a queued call that was aborted passes its slot on by calling release() again.
--   * Small bounds. Two new calls are enough to break the released code. For the fix, the theorem
--     fix_reserves_slots checks the invariant behind no_overtaking_fix, and no event can break it
--     whatever the bounds.
--   * Event probabilities are uniform only so that every event is possible at every step. The
--     theorems quantify over every reachable run; no probability here is a production rate.
--
-- handoff = false is the released code. handoff = true is the proposed fix: a finishing call hands
-- its slot to the next queued call (`active` only goes down when the queue is empty, so the slot
-- stays counted while the call is pending), and that call starts without repeating the checks.

enum Event = Finish | Arrive | Handoff

def capacity : Num := 2    -- bulkhead(2, 2)
def queue_cap : Num := 2

system Bulkhead(handoff : Bool, start_running : Num, start_queued : Num, max_arrivals : Num) {
  var running : Num := start_running
  var queued : Num := start_queued
  var pending : Num := 0
  var arrivals : Num := 0

  -- Bookkeeping for the theorems; the bulkhead has no such fields.
  var queued_rejected : Bool := false   -- a call that had been queued got BulkheadRejectedError
  var overtaken : Bool := false         -- a later call got a slot while an earlier one waited for one

  step {
    let used := if handoff then running + pending else running
    let event := {Finish: 1/3, Arrive: 1/3, Handoff: 1/3}
    match event {
      Finish => {
        if running > 0 {
          running := running - 1
          if queued > 0 { queued := queued - 1; pending := pending + 1 }
        }
      }
      Arrive => {
        if arrivals < max_arrivals {
          arrivals := arrivals + 1
          if used < capacity {
            -- a call that is still waiting for a slot: queued, or (released code) dequeued but
            -- not yet started; with the fix a pending call already owns its slot
            if queued + (if handoff then 0 else pending) > 0 { overtaken := true }
            running := running + 1
          } else if queued < queue_cap {
            queued := queued + 1
          }
        }
      }
      Handoff => {
        if pending > 0 {
          pending := pending - 1
          if handoff {
            running := running + 1
          } else if used < capacity {
            running := running + 1
          } else if queued < queue_cap {
            queued := queued + 1
            overtaken := true
          } else {
            queued_rejected := true
          }
        }
      }
    }
  }
}

-- readme.md, bulkhead.execute: "Queues the function for execution and returns its results when it
-- runs"; bulkhead.queueSlots: "If either this or `bulkhead.executionSlots` is greater than zero,
-- the `execute()` will not throw a `BulkheadRejectedError`." A queued call should not be rejected.
theorem queued_call_not_rejected : Bulkhead(false, 2, 2, 3) |= always not queued_rejected
-- The readme does not state an order. A queue is normally first in, first out, and the test
-- 'queues requests, and rejects after queue limit' (src/BulkheadPolicy.test.ts, lines 194-217)
-- expects queued calls to start in the order they were queued.
theorem no_overtaking : Bulkhead(false, 2, 2, 3) |= always not overtaken

theorem queued_call_not_rejected_fix : Bulkhead(true, 2, 2, 3) |= always not queued_rejected
theorem no_overtaking_fix : Bulkhead(true, 2, 2, 3) |= always not overtaken

-- The same from an empty bulkhead with seven calls in total.
theorem queued_call_not_rejected_from_empty : Bulkhead(false, 0, 0, 7) |= always not queued_rejected
theorem queued_call_not_rejected_from_empty_fix : Bulkhead(true, 0, 0, 7) |= always not queued_rejected

-- Both versions keep the limits: at most 2 calls hold a slot and at most 2 wait in the queue.
theorem within_limits : Bulkhead(false, 0, 0, 7) |= always (running <= capacity and queued <= queue_cap)
theorem within_limits_fix : Bulkhead(true, 0, 0, 7) |= always (running + pending <= capacity and queued <= queue_cap)
-- With the fix, every slot is held while a call waits in the queue.
theorem fix_reserves_slots : Bulkhead(true, 0, 0, 7) |= always (queued > 0 implies running + pending == capacity)

-- Scenario 1 of the reproduction (A1 and A2 finish together, A1's caller submits N1, N2, N3, and Y
-- is rejected) ends in this state, and it is reachable:
#prob Bulkhead(false, 2, 2, 3) |= eventually (queued_rejected and arrivals == 3 and running == 2 and queued == 2)

-- The fix still fills both slots and the queue.
#prob Bulkhead(true, 0, 0, 7) |= eventually (running == capacity and queued == queue_cap)
#prob Bulkhead(true, 2, 2, 3) |= eventually (running == capacity and queued == queue_cap and arrivals == 3)
