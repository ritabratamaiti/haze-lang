-- Classic probability problems, each with a known closed-form answer.
-- Every result below is exact; compare with the formula in the comment.

-- 1. Two fair dice ------------------------------------------------------------
input d1 : Num ~ uniform(1, 6)
input d2 : Num ~ uniform(1, 6)
def total : Num := d1 + d2

#eval total                        -- triangular distribution on 2..12
#prob total == 7                   -- 6/36 = 1/6
#expect total                      -- 7
claim doubles : d1 == d2           -- 1/6
claim at_least_one_six : d1 == 6 or d2 == 6    -- 1 - (5/6)^2 = 11/36

-- 2. Ten fair coin flips -----------------------------------------------------
input heads : Num ~ binomial(10, 0.5)
#prob heads >= 8                   -- (45 + 10 + 1) / 1024 = 7/128
#expect heads                      -- 5

-- 3. The birthday problem ----------------------------------------------------
-- People enter one at a time; the k-th newcomer shares a birthday with one of
-- the k people already present with probability k/365.
system Birthday {
  var people : Num := 0
  var shared : Bool := false
  step {
    if not shared {
      if flip(people / 365) { shared := true }
      people := people + 1
    }
  }
}
claim birthday_23 : Birthday |= after[23] shared   -- 1 - 365!/(342! 365^23) ≈ 0.507297
claim birthday_50 : Birthday |= after[50] shared   -- ≈ 0.970374

-- 4. Pólya's urn ---------------------------------------------------------------
-- Start with one red and one blue ball. Draw a ball, return it with another of
-- the same color. After n draws the number of red balls is uniform on 1..n+1.
system Polya {
  var red : Num := 1
  var blue : Num := 1
  step {
    if flip(red / (red + blue)) { red := red + 1 } else { blue := blue + 1 }
  }
}
#eval Polya |= after[5] red        -- 1..6, each with probability 1/6

-- 5. Coupon collector with 4 coupons -----------------------------------------
system Coupons {
  var have : Num := 0
  var draws : Num := 0
  step {
    if have < 4 {
      draws := draws + 1
      if flip((4 - have) / 4) { have := have + 1 }
    }
  }
}
-- P(all 4 collected within 10 draws) = Σⱼ (-1)^j C(4,j) (1 - j/4)^10
claim all_within_10 : Coupons |= eventually[10] have == 4
-- E[draws] = 4 (1 + 1/2 + 1/3 + 1/4) = 25/3; the horizon truncates a tiny tail
#expect Coupons |= after[80] draws

-- 6. Gambler's ruin -----------------------------------------------------------
-- Start with 3, bet 1 per round, stop at 0 or 6. With win probability p and
-- r = (1-p)/p, P(reach 6) = (1 - r^3) / (1 - r^6): 1/2 for p = 1/2, 8/35 for p = 0.4.
system FairGame {
  var money : Num := 3
  step {
    if money > 0 and money < 6 {
      if flip(0.5) { money := money + 1 } else { money := money - 1 }
    }
  }
}
system BiasedGame {
  var money : Num := 3
  step {
    if money > 0 and money < 6 {
      if flip(0.4) { money := money + 1 } else { money := money - 1 }
    }
  }
}
claim fair_win : FairGame |= eventually[200] money == 6
claim biased_win : BiasedGame |= eventually[200] money == 6
theorem never_negative : BiasedGame |= always[200] money >= 0

-- The same game when the win probability is only known vaguely ("about fair,
-- maybe slightly against us"). The answer becomes a belief–plausibility interval.
param p : Num ~= {0.4: 0.3, 0.45: 0.7, 0.5: 1}
system VagueGame {
  var money : Num := 3
  step {
    if money > 0 and money < 6 {
      if flip(p) { money := money + 1 } else { money := money - 1 }
    }
  }
}
claim vague_win : VagueGame |= eventually[200] money == 6

-- 7. The boy–girl paradox -----------------------------------------------------
-- A family has two children, and at least one is a boy. P(two boys) = 1/3.
-- (Conditioning applies to every later declaration, so this comes last.)
enum Sex = Boy | Girl
input first : Sex ~ {Boy: 0.5, Girl: 0.5}
input second : Sex ~ {Boy: 0.5, Girl: 0.5}
observe first == Boy or second == Boy
#prob first == Boy and second == Boy
