-- Games of chance with known closed-form answers: craps, a single game of tennis
-- and Penney's coin game.

enum Phase = ComeOut | OnPoint | Won | Lost

-- 1. Craps ---------------------------------------------------------------------------
-- The shooter rolls two dice. On the first (come-out) roll, a total of 7 or 11 wins
-- and 2, 3 or 12 loses. Any other total becomes the point, and the shooter keeps
-- rolling until the point comes up again (a win) or a 7 does (a loss). The
-- probability of winning is 244/495 ≈ 0.492929.
system Craps {
  var phase : Phase := ComeOut
  var point : Num := 0
  step {
    let roll := uniform(1, 6) + uniform(1, 6)
    match phase {
      ComeOut => {
        if roll == 7 or roll == 11 { phase := Won }
        else if roll == 2 or roll == 3 or roll == 12 { phase := Lost }
        else { point := roll; phase := OnPoint }
      }
      OnPoint => {
        if roll == point { phase := Won } else if roll == 7 { phase := Lost }
      }
      _ => skip
    }
  }
}
claim shooter_wins : Craps |= eventually phase == Won       -- exactly 244/495
claim decided_on_come_out : Craps |= after[1] (phase == Won or phase == Lost)   -- 12/36: 8 winning rolls, 4 losing

-- 2. A game of tennis ------------------------------------------------------------------
-- The server wins each point with probability p = 0.6 and loses it with q = 0.4.
-- Winning the game takes at least four points and a lead of two. From deuce, the
-- server goes on to win with probability p² / (1 - 2pq).
system Tennis {
  var server : Num := 0
  var receiver : Num := 0
  step {
    if not ((server >= 4 or receiver >= 4) and abs(server - receiver) >= 2) {
      if flip(0.6) { server := server + 1 } else { receiver := receiver + 1 }
      -- every tie from 3-3 on is the same deuce state, so fold it back to 3-3; this
      -- keeps the number of states finite, so Haze can look at games of any length
      if server >= 3 and receiver >= 3 and server == receiver { server := 3; receiver := 3 }
    }
  }
}
claim server_holds : Tennis |= eventually (server >= 4 and server - receiver >= 2)

-- 3. Penney's game -----------------------------------------------------------------------
-- A fair coin is flipped until either HHT or HTT appears, and HHT comes first with
-- probability 2/3. The variables before and last hold the previous two flips,
-- coded as 0 = nothing yet, 1 = heads and 2 = tails; winner becomes 1 for HHT and
-- 2 for HTT.
system Penney {
  var before : Num := 0
  var last : Num := 0
  var winner : Num := 0
  step {
    if winner == 0 {
      let coin := if flip(0.5) then 1 else 2
      if before == 1 and last == 1 and coin == 2 { winner := 1 }
      else if before == 1 and last == 2 and coin == 2 { winner := 2 }
      before := last
      last := coin
    }
  }
}
claim hht_first : Penney |= eventually winner == 1
