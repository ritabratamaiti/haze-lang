-- Physics: radioactive decay, diffusion between two chambers, and a random walk.

-- 1. Radioactive decay ----------------------------------------------------------
-- 20 nuclei; each decays with probability 0.1 per time step, independently.
-- The expected number left after t steps is 20 · 0.9^t.
system Decay {
  var nuclei : Num := 20
  step { nuclei := nuclei - binomial(nuclei, 0.1) }
}
#expect Decay |= after[10] nuclei              -- 20 · 0.9^10 ≈ 6.973569
claim half_left_after_7 : Decay |= after[7] nuclei >= 10
theorem never_grows : Decay |= always[20] nuclei <= 20

-- When the decay constant is only known roughly, so is the expected count.
param rate : Num ~= {0.05: 0.5, 0.1: 1, 0.15: 0.5}
system VagueDecay {
  var nuclei : Num := 20
  step { nuclei := nuclei - binomial(nuclei, rate) }
}
#expect VagueDecay |= after[10] nuclei         -- 20·0.85^10, 20·0.9^10, 20·0.95^10

-- 2. The Ehrenfest model of diffusion (lazy version) ----------------------------
-- 4 molecules in two chambers, all on the left at the start. Each step, with
-- probability 1/2, a random molecule moves to the other chamber. The number on
-- the left tends to binomial(4, 1/2), and its mean is 2 + 2 · (3/4)^t.
system Ehrenfest {
  var left : Num := 4
  step {
    if flip(0.5) {
      if uniform(1, 4) <= left { left := left - 1 } else { left := left + 1 }
    }
  }
}
#eval Ehrenfest |= after[40] left              -- ≈ 1/16, 4/16, 6/16, 4/16, 1/16
#expect Ehrenfest |= after[40] left            -- 2 + 2 · 0.75^40

-- 3. A symmetric random walk ------------------------------------------------------
-- The probability of returning to the start within 2n steps is 1 - C(2n, n) / 4^n.
system Walk {
  var position : Num := 0
  var steps : Num := 0
  step {
    steps := steps + 1
    if flip(0.5) { position := position + 1 } else { position := position - 1 }
  }
}
claim returns_within_20 : Walk |= eventually[20] (steps > 0 and position == 0)  -- 1 - 184756/1048576
