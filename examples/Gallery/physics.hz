-- Random processes from physics: radioactive decay, diffusion of molecules between
-- two chambers, and a symmetric random walk.

-- 1. Radioactive decay ----------------------------------------------------------
-- A sample starts with 20 nuclei, and in each time step every nucleus decays
-- independently with probability 0.1. Since 90% survive each step on average, the
-- expected number left after t steps is 20 · 0.9^t.
system Decay {
  var nuclei : Num := 20
  step { nuclei := nuclei - binomial(nuclei, 0.1) }
}
#expect Decay |= after[10] nuclei              -- 20 · 0.9^10 ≈ 6.973569
claim half_left_after_7 : Decay |= after[7] nuclei >= 10
theorem never_grows : Decay |= always[20] nuclei <= 20

-- If the decay rate is only known roughly, the expected count is only known
-- roughly too, and Haze reports it as an interval.
param rate : Num ~= {0.05: 0.5, 0.1: 1, 0.15: 0.5}
system VagueDecay {
  var nuclei : Num := 20
  step { nuclei := nuclei - binomial(nuclei, rate) }
}
#expect VagueDecay |= after[10] nuclei         -- 20·0.95^10, 20·0.9^10 or 20·0.85^10 depending on rate

-- 2. The Ehrenfest model of diffusion (lazy version) ----------------------------
-- Four molecules share two chambers, and all of them start on the left. In each
-- step, with probability 1/2, a molecule chosen at random moves to the other
-- chamber; otherwise nothing happens, which is what makes this version lazy. Over
-- time the number on the left settles into binomial(4, 1/2), and its mean after
-- t steps is 2 + 2 · (3/4)^t.
system Ehrenfest {
  var left : Num := 4
  step {
    if flip(0.5) {
      if uniform(1, 4) <= left { left := left - 1 } else { left := left + 1 }
    }
  }
}
#eval Ehrenfest |= after[40] left              -- close to 1/16, 4/16, 6/16, 4/16, 1/16 for 0 to 4
#expect Ehrenfest |= after[40] left            -- 2 + 2 · 0.75^40

-- 3. A symmetric random walk ------------------------------------------------------
-- A walker steps left or right with equal probability. The chance of being back at
-- the start at some point within 2n steps is 1 - C(2n, n) / 4^n, and the claim
-- below uses n = 10.
system Walk {
  var position : Num := 0
  var steps : Num := 0
  step {
    steps := steps + 1
    if flip(0.5) { position := position + 1 } else { position := position - 1 }
  }
}
claim returns_within_20 : Walk |= eventually[20] (steps > 0 and position == 0)  -- 1 - 184756/1048576
