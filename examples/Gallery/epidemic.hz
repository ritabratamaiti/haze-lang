-- The Reed–Frost chain-binomial model of an infection spreading through a
-- household of five people.
--
-- At the start one person is infected and the other four are susceptible. The
-- infection spreads in generations: a susceptible person escapes each currently
-- infected person independently with probability 1 - p, so with I people infected
-- they catch it with probability 1 - (1 - p)^I. The transmission probability p is
-- only known roughly ("about 0.3"), so it is a fuzzy parameter.

param p : Num ~= {0.2: 0.5, 0.3: 1, 0.5: 0.4}

-- The chance of escaping i infected people, (1 - p)^i, written as a recursive function.
def escape(i : Num) : Num := if i <= 0 then 1 else (1 - p) * escape(i - 1)

system Household {
  var susceptible : Num := 4
  var infected : Num := 1
  var total : Num := 1
  step {
    let cases := binomial(susceptible, 1 - escape(infected))
    susceptible := susceptible - cases
    infected := cases
    total := total + cases
  }
}

theorem people_conserved : Household |= always[6] susceptible + total == 5
#eval Household |= after[5] total             -- distribution of the final outbreak size
#expect Household |= after[5] total
claim large_outbreak : Household |= after[5] total >= 3
claim over_in_two_generations : Household |= eventually[2] infected == 0

-- The same household after two of the four susceptible people are vaccinated,
-- which leaves only two who can catch the infection.
system Vaccinated {
  var susceptible : Num := 2
  var infected : Num := 1
  var total : Num := 1
  step {
    let cases := binomial(susceptible, 1 - escape(infected))
    susceptible := susceptible - cases
    infected := cases
    total := total + cases
  }
}
#expect Vaccinated |= after[5] total
claim vaccinated_large_outbreak : Vaccinated |= after[5] total >= 3
