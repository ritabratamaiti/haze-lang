-- Two models from finance and insurance: pricing options on a binomial tree, and the
-- chance that an insurer runs out of money.

-- 1. Cox–Ross–Rubinstein option pricing, three periods -------------------------------
-- A stock starts at 100 and each period either rises 20% or falls 10%. With a
-- risk-free rate of 5% per period, the risk-neutral probability of a rise is
-- (1.05 - 0.9) / (1.2 - 0.9) = 1/2. A European option is then worth its expected
-- payoff under these probabilities, discounted over the three periods by 1.05³.
system Stock {
  var price : Num := 100
  step { if flip(0.5) { price := price * 1.2 } else { price := price * 0.9 } }
}
def discount : Num := 1.05 * 1.05 * 1.05

#eval Stock |= after[3] price
#expect Stock |= after[3] max(price - 100, 0) / discount     -- call option with strike 100
#expect Stock |= after[3] max(100 - price, 0) / discount     -- put option with strike 100
-- Put–call parity says the call minus the put is worth 100 - 100 / 1.05³.
#expect Stock |= after[3] (max(price - 100, 0) - max(100 - price, 0)) / discount

-- Now suppose the volatility is only known roughly, so the up factor is "about
-- 1.2". The down factor is taken to be 1 / up, which makes this a different model
-- from the one above (there the down factor was 0.9), and the risk-neutral
-- probability is computed from both factors. The call price comes out as an
-- interval.
param up : Num ~= {1.1: 0.5, 1.2: 1, 1.3: 0.5}
def down : Num := 1 / up
def q : Num := (1.05 - down) / (up - down)
system VagueStock {
  var price : Num := 100
  step { if flip(q) { price := price * up } else { price := price * down } }
}
#expect VagueStock |= after[3] max(price - 100, 0) / discount

-- 2. The risk of ruin of an insurer ------------------------------------------------
-- An insurer starts with capital 3 and collects a premium of 1 per period. In each
-- period it pays a claim of 0, 2 or 5 with probabilities 0.7, 0.2 and 0.1. The
-- expected claim of 0.9 is below the premium, but a run of large claims can still
-- push the capital below zero. That counts as ruin, and from then on the state no
-- longer changes.
system Insurer {
  var capital : Num := 3
  var ruined : Bool := false
  step {
    if not ruined {
      capital := capital + 1 - {0: 0.7, 2: 0.2, 5: 0.1}
      if capital < 0 { ruined := true }
    }
  }
}
claim ruin_within_20 : Insurer |= eventually[20] ruined
theorem ruin_is_final : Insurer |= always[20] (ruined implies capital < 0)
