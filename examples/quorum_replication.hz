-- Leaderless replication in the style of Dynamo, with N = 3 replicas.
--
-- The client sends a write to all three replicas and treats it as acknowledged once
-- W of them have stored it. A later read contacts R replicas. The classic rule says
-- that if R + W > N, every read quorum overlaps every write quorum, so you always
-- read your own writes. Haze proves this for W = 2, R = 2, and for the cheaper
-- W = 2, R = 1 it finds a stale read and measures how often it happens.

param drop : Num ~= {0.01: 1, 0.05: 0.6, 0.2: 0.2}   -- per-message loss rate, only roughly known

enum Phase = Write | Read | Finished

-- A fresh coin flip on every call, so each replica loses its copy independently.
def stored() : Bool := not flip(drop)

-- W = 2, R = 2, so R + W > N.
system Quorum22 {
  var phase : Phase := Write
  var r1 : Bool := false
  var r2 : Bool := false
  var r3 : Bool := false
  var acked : Bool := false
  var fresh : Bool := false        -- did the read see the new value?
  step {
    match phase {
      Write => {
        r1 := stored(); r2 := stored(); r3 := stored()
        let copies := (if r1 then 1 else 0) + (if r2 then 1 else 0) + (if r3 then 1 else 0)
        acked := copies >= 2
        phase := Read
      }
      Read => {
        -- the coordinator reads from two distinct replicas, chosen uniformly at random
        let pair := uniform(1, 3)
        fresh := if pair == 1 then r1 or r2 else if pair == 2 then r1 or r3 else r2 or r3
        phase := Finished
      }
      _ => skip
    }
  }
}

-- W = 2, R = 1, so R + W = N. Reads are cheaper, but a read can now land on the one
-- replica that missed the write.
system Quorum21 {
  var phase : Phase := Write
  var r1 : Bool := false
  var r2 : Bool := false
  var r3 : Bool := false
  var acked : Bool := false
  var fresh : Bool := false
  step {
    match phase {
      Write => {
        r1 := stored(); r2 := stored(); r3 := stored()
        let copies := (if r1 then 1 else 0) + (if r2 then 1 else 0) + (if r3 then 1 else 0)
        acked := copies >= 2
        phase := Read
      }
      Read => {
        let one := uniform(1, 3)
        fresh := if one == 1 then r1 else if one == 2 then r2 else r3
        phase := Finished
      }
      _ => skip
    }
  }
}

-- Durability: an acknowledged write is stored on at least two replicas.
theorem durable : Quorum22 |= always[2] (acked implies ((if r1 then 1 else 0) + (if r2 then 1 else 0) + (if r3 then 1 else 0) >= 2))

-- With R + W > N, read-your-writes holds on every path.
theorem read_your_writes : Quorum22 |= always[2] ((phase == Finished and acked) implies fresh)
-- With R + W = N it fails. Haze rejects the theorem and prints a concrete stale read,
-- and the claim below gives the probability of one.
theorem read_your_writes_r1 : Quorum21 |= always[2] ((phase == Finished and acked) implies fresh)
claim stale_read_risk : Quorum21 |= after[2] (acked and not fresh)

-- Availability: under the roughly known loss rate, writes should be acknowledged at least
-- 95% of the time.
claim write_available : Quorum22 |= after[2] acked with prob >= 0.95
