-- Raft leader election with randomized timeouts
--
-- Raft (Ongaro and Ousterhout, USENIX ATC 2014) elects a leader when followers stop hearing
-- from the old one. Each server waits for an election timeout, then becomes a candidate, votes
-- for itself and asks the others for their votes; a candidate with votes from a majority becomes
-- leader for that term. If several servers time out together they split the vote, nobody wins,
-- and they try again in a new term. Raft avoids endless split votes by choosing each timeout at
-- random, from 150 to 300 ms in the paper.
--
-- Frameworks such as Veil prove safety properties of distributed protocols in Lean, such as never
-- electing two leaders in one term, for any number of servers. Safety says nothing about whether
-- or how fast a leader gets elected, which depends on the random timeouts. Haze checks safety
-- too, though only for this model's three servers and a bounded number of rounds, and it computes
-- the election probabilities exactly. Time is measured in 10 ms ticks, and a message takes `delay`
-- ticks to arrive (the paper puts broadcast time between 0.5 and 20 ms).

system Election(randomized : Bool, delay : Num) {
  var term : Num := 0
  var elected : Bool := false
  var leaders : Num := 0             -- servers that won a majority in the latest term
  var elapsed : Num := 0             -- ticks until a leader was elected
  step {
    if not elected {
      term := term + 1
      -- each server's timeout, in ticks: 150 to 300 ms, or always 150 ms without randomization
      let t1 := if randomized then uniform(15, 30) else 15
      let t2 := if randomized then uniform(15, 30) else 15
      let t3 := if randomized then uniform(15, 30) else 15
      let first := min(t1, min(t2, t3))
      -- a server becomes a candidate if it times out before the first vote request reaches it
      let c1 := t1 < first + delay
      let c2 := t2 < first + delay
      let c3 := t3 < first + delay
      -- a server that isn't a candidate votes for the earliest candidate, picking at random
      -- between two that timed out at the same moment
      let tie12 := c1 and c2 and t1 == first and t2 == first
      let tie13 := c1 and c3 and t1 == first and t3 == first
      let tie23 := c2 and c3 and t2 == first and t3 == first
      let coin := flip(0.5)
      let pick := if t1 == first and c1 and not ((tie12 or tie13) and coin) then 1
        else if t2 == first and c2 and not (tie23 and coin) then 2
        else 3
      let followers1 := (if not c2 and pick == 1 then 1 else 0) + (if not c3 and pick == 1 then 1 else 0)
      let followers2 := (if not c1 and pick == 2 then 1 else 0) + (if not c3 and pick == 2 then 1 else 0)
      let followers3 := (if not c1 and pick == 3 then 1 else 0) + (if not c2 and pick == 3 then 1 else 0)
      let v1 := (if c1 then 1 else 0) + followers1
      let v2 := (if c2 then 1 else 0) + followers2
      let v3 := (if c3 then 1 else 0) + followers3
      leaders := (if v1 >= 2 then 1 else 0) + (if v2 >= 2 then 1 else 0) + (if v3 >= 2 then 1 else 0)
      elected := leaders >= 1
      -- a round takes until the first timeout, plus a request and a reply if someone wins
      elapsed := elapsed + first + (if leaders >= 1 then 2 * delay else 0)
    }
  }
}

-- Safety: no term ever has two leaders, with or without randomization.
theorem one_leader : Election(true, 1) |= always[6] leaders <= 1
theorem one_leader_slow_network : Election(true, 2) |= always[6] leaders <= 1
theorem one_leader_fixed : Election(false, 1) |= always[6] leaders <= 1

-- Without randomization every server times out at once, every round is a split vote, and no
-- leader is ever elected. Haze proves the livelock rather than just observing it.
theorem fixed_timeouts_livelock : Election(false, 1) |= always[20] not elected

-- With randomization, how likely is the first round to succeed, and how soon is there a leader?
claim first_round : Election(true, 1) |= after[1] elected
claim first_round_slow_network : Election(true, 2) |= after[1] elected
claim within_three_rounds : Election(true, 2) |= eventually[3] elected with prob >= 0.999
-- Expected milliseconds until there is a leader, counting runs that need more than three rounds
-- (under 2 in 100,000) only up to the third round.
#expect Election(true, 1) |= after[3] elapsed * 10
#expect Election(true, 2) |= after[3] elapsed * 10
