-- A progressive (canary) rollout of a release whose defect rate is uncertain.
--
-- The release goes to 1% of traffic, then 10%, then 50%, and finally 100%. At each of
-- the first three stages, monitoring samples 50 requests, and a single failure among
-- them rolls the release back automatically.
--
-- "The build is probably fine, but QA was rushed" is a rough judgment about the defect
-- rate, not a probability, so the defect rate is a fuzzy parameter. Haze keeps the two
-- kinds of uncertainty apart and reports intervals.

enum Stage = Canary1 | Canary10 | Half | Full | RolledBack

param defect : Num ~= {0: 1, 0.005: 0.8, 0.02: 0.5, 0.1: 0.2}

def samples : Num := 50

system Rollout {
  var stage : Stage := Canary1
  var exposure : Num := 0          -- sum of the traffic shares of the stages reached so far
  step {
    match stage {
      Canary1 => {
        exposure := exposure + 1
        if binomial(samples, defect) > 0 { stage := RolledBack } else { stage := Canary10 }
      }
      Canary10 => {
        exposure := exposure + 10
        if binomial(samples, defect) > 0 { stage := RolledBack } else { stage := Half }
      }
      Half => {
        exposure := exposure + 50
        if binomial(samples, defect) > 0 { stage := RolledBack } else { stage := Full }
      }
      _ => skip
    }
  }
}

-- A bad build must never reach 100% of traffic. Because the defect rate is only roughly known,
-- the answer is graded rather than a plain yes or no.
claim bad_build_contained : Rollout |= always[4] (stage == Full implies defect == 0)
claim reaches_full : Rollout |= eventually[4] stage == Full
#expect Rollout |= after[4] exposure
#outcomes Rollout |= after[4] stage

-- A statement that depends on the parameter can still be a theorem. Here, a clean
-- build always ships, whatever the defect rate turns out to be.
theorem ships_when_clean : Rollout |= after[4] (defect == 0 implies stage == Full)
