-- Exact probabilistic reasoning -------------------------------------------------

-- Monty Hall: the host always opens a door that is neither your pick nor the car,
-- and switching wins with probability 2/3.
input car  : Num ~ uniform(1, 3)
input pick : Num ~ uniform(1, 3)
input host : Num ~ if car == pick
                   then (if car == 1 then {2: 1/2, 3: 1/2}
                         else if car == 2 then {1: 1/2, 3: 1/2}
                         else {1: 1/2, 2: 1/2})
                   else 6 - car - pick
def switched : Num := 6 - pick - host
claim switch_wins : switched == car
claim stay_wins : pick == car with prob <= 0.34

-- A Bayesian update: after a positive test, a condition that affects 1% of people
-- is still unlikely, because false positives from the healthy majority dominate.
input sick : Bool ~ flip(0.01)
input positive : Bool ~ if sick then flip(0.95) else flip(0.05)
observe positive
#prob sick

-- Crisp theorems over bounded domains -------------------------------------------
-- no_square_49 is false (7 * 7 == 49), so it should be refuted with x = 7.
theorem add_comm_small : forall x in 0..20, forall y in 0..20, x + y == y + x
theorem no_square_49 : forall x in 0..10, x * x != 49

-- Fuzzy parameters: possibility / necessity ---------------------------------------
param load : Num ~= {50: 0.5, 70: 1, 90: 0.4}
claim overloaded : load > 80
claim fine : load <= 80

-- Fuzzy predicates and stochastic conditionals ----------------------------------
def hot(x : Num) : Deg := ramp_up(x, 25, 35)
input temp : Num ~ {20: 0.5, 30: 0.5}
claim is_hot : temp is hot
def alarm : Bool := if temp is hot then true else false
#check alarm
#prob alarm
#check temp is very hot and not (temp > 25)

-- The kernel enforces declared grades -------------------------------------------
-- Both definitions below must be rejected: noisy is random but declared @crisp,
-- and wrong gives a Bool where a Num was declared.
def noisy : Num @crisp := uniform(1, 3)
def wrong : Num := true

-- Recursion with fuel: unknown outcomes widen the interval -----------------------
-- Recursive calls run on a limited budget (fuel). collatz(27, 0) finishes within
-- it, but spin never terminates, so its outcome is unknown and the claim gets
-- belief 0 and plausibility 1.
def collatz(n : Num, k : Num) : Num :=
  if n == 1 then k else if floor(n / 2) * 2 == n then collatz(n / 2, k + 1) else collatz(3 * n + 1, k + 1)
#eval collatz(27, 0)
def spin(n : Num) : Bool := spin(n + 1)
claim diverges : spin(0)
#print spin

-- Transition systems -------------------------------------------------------------
system Coin {
  var heads : Num := 0
  step { if flip(0.5) { heads := heads + 1 } }
}
#eval Coin |= after[3] heads
claim some_heads : Coin |= eventually[3] heads >= 1
claim no_heads : Coin |= always[3] heads == 0
#print Coin
